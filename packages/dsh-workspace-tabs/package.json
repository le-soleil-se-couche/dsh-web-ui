{
  "name": "@linxin666/dsh-client-ui-workspace-tabs",
  "description": "Workspace and conversation tabs, browser-style navigation, and macOS-only window dragging for DeepSeek Harness.",
  "version": "0.4.18",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.2"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.2"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.2",
    "typescript": "~5.7.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.2-rc.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "icon.svg",
    "locale"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/le-soleil-se-couche/dsh-web-ui.git",
    "directory": "packages/dsh-workspace-tabs"
  }
}
